# Copy this file to .env and fill in the values. .env is never committed.
# The live site reads the same names from Vercel → Project → Settings → Environment Variables.

# Main model (Google AI Studio / Gemini, OpenAI-compatible endpoint)
LLM_API_KEY=your-gemini-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Optional fallback provider, tried when the main one fails (TokenRouter, Groq, ...)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.tokenrouter.com/v1
FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Daily cap. QUOTA_SECRET must match the database: in Supabase → SQL Editor run
#   select v from public.app_secret where k = 'quota';
QUOTA_SECRET=
DAILY_PER_VISITOR=8
DAILY_TOTAL=150

PORT=3000
